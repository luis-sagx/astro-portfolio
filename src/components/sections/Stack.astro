---
import type { Translation } from '../../i18n/types';
import Key3D from '../atoms/Key3D.astro';
import SectionHeading from '../molecules/SectionHeading.astro';

interface KeyboardKey {
  name: string;
  width: number;
  tone: 'center' | 'edge' | 'spacebar';
  category: string;
}

interface Props {
  messages: Translation;
}

const { messages } = Astro.props;

const keyboardRowConfig = [
  { widths: [1.4, 1, 1, 1, 1, 1, 1.1] },
  { widths: [1.25, 1, 1, 1, 1, 1, 1.25] },
  { widths: [1.25, 1, 1, 1, 1, 1, 1.25] },
  { widths: [1.4, 1, 3.9, 1.2] },
];

const categoryBySkill = new Map(
  messages.data.skillCategories.flatMap((category) =>
    category.skills.map((skill) => [skill.name, category.title]),
  ),
);

const stackRows = [
  ['JavaScript', 'TypeScript', 'Python', 'Java', 'C#', 'Angular', 'React'],
  ['Tailwind CSS', 'Flutter', 'Astro', 'Node.js', 'Express', 'ASP.NET Core', 'Flask'],
  ['Spring Boot', 'Firebase', 'MongoDB', 'PostgreSQL', 'MySQL', 'SQL Server', 'n8n'],
  ['Docker', 'Git', 'Linux', 'Postman'],
];

const getTone = (name: string, keyIndex: number, rowLength: number): KeyboardKey['tone'] => {
  if (name === 'Linux') return 'spacebar';
  return keyIndex === 0 || keyIndex === rowLength - 1 ? 'edge' : 'center';
};

const keyboardRows = stackRows.map((row, rowIndex) => ({
  keys: row.map((name, keyIndex) => {
    const category = categoryBySkill.get(name) ?? '';
    return {
      name,
      width: keyboardRowConfig[rowIndex].widths[keyIndex],
      tone: getTone(name, keyIndex, row.length),
      category,
    } satisfies KeyboardKey;
  }),
}));
---

<section id="stack" class="bg-canvas px-4 py-24 sm:px-6 lg:py-32">
  <div class="mx-auto max-w-6xl">
    <SectionHeading
      letter="S"
      title={messages.stackSection.title}
      sub={messages.stackSection.sub}
    />

    <p
      id="key-legend"
      class="min-h-6 text-center font-mono text-accent"
      aria-live="polite"
    >
    </p>

    <div class="kb-scene" data-animate="fade-up">
      <div class="kb-board">
        <div class="kb-plate">
          {keyboardRows.map((rowData) => (
            <div class="kb-row">
              {rowData.keys.map((key) => (
                <Key3D name={key.name} widthUnits={key.width} tone={key.tone} category={key.category} />
              ))}
            </div>
          ))}
        </div>
        <span class="kb-case-front" aria-hidden="true"></span>
      </div>
      <span class="kb-shadow" aria-hidden="true"></span>
      <span class="kb-glow" aria-hidden="true"></span>
    </div>
  </div>
</section>

<style>
  .kb-scene {
    position: relative;
    display: flex;
    justify-content: center;
    overflow-x: clip;
    padding-block: 3rem 4rem;
    perspective: 1300px;
  }

  .kb-board {
    position: relative;
    transform: rotateX(38deg) rotateZ(-2deg);
    transform-style: preserve-3d;
  }

  .kb-plate {
    display: flex;
    flex-direction: column;
    gap: clamp(3px, 0.7vw, 6px);
    padding: clamp(8px, 1.5vw, 14px);
    background: var(--sunken);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    transform-style: preserve-3d;
  }

  .kb-row {
    display: flex;
    justify-content: center;
    gap: clamp(3px, 0.7vw, 6px);
    transform-style: preserve-3d;
  }

  .kb-case-front {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 16px;
    transform-origin: top;
    transform: rotateX(-90deg);
    background: color-mix(in oklch, var(--sunken) 55%, black);
    border-radius: 0 0 var(--radius-md) var(--radius-md);
  }

  .kb-shadow {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    width: min(70%, 640px);
    height: 36px;
    transform: translateX(-50%);
    background: oklch(0 0 0 / 0.28);
    border-radius: 50%;
    filter: blur(22px);
    pointer-events: none;
  }

  .kb-glow {
    position: absolute;
    bottom: 1.5rem;
    left: 50%;
    width: min(60%, 560px);
    height: 30px;
    transform: translateX(-50%);
    background: var(--accent);
    border-radius: 50%;
    filter: blur(36px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease-out;
  }

  :global(html.dark) .kb-glow {
    opacity: 0.22;
  }

</style>

<script>
  const legend = document.getElementById('key-legend');

  document.addEventListener('mouseover', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const key = target.closest('[data-tech]');
    if (!key || !legend) return;
    const tech = key.getAttribute('data-tech') ?? '';
    const category = key.getAttribute('data-category') ?? '';
    legend.textContent = category ? `${category} · ${tech}` : tech;
  });

  document.addEventListener('mouseout', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    if (!target.closest('[data-tech]') || !legend) return;
    legend.textContent = '';
  });
</script>
